{
  "name": "mycl",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "node scripts/measure-size.mjs",
    "check-dce": "node scripts/check-prod-dce.mjs",
    "check-changelog": "node scripts/check-changelog.mjs packages/core",
    "smoke": "node scripts/smoke-artifacts.mjs",
    "publish-packages": "pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "es5-ext"]
  }
}
