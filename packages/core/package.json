{
  "name": "@mycl/core",
  "version": "0.1.1",
  "description": "Zero-dependency capability/registry system: mint a channel, define capabilities, layer registries, and resolve them through mycl() factories and scopes, in under 2 KB",
  "keywords": [
    "capability",
    "registry",
    "composition",
    "extension",
    "plugin",
    "zero-dependency",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://mycl.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgullstr/mycl.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/jgullstr/mycl/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.mjs"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.mjs"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "default": "./dist/factory/index.mjs"
    },
    "./introspect": {
      "types": "./dist/introspect.d.ts",
      "default": "./dist/introspect.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.16"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-changelog.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
